# ============================================================
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/
.hypothesis/

# ============================================================
# IDEs and editors
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

