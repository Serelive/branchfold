# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build / packaging artifacts
build/
dist/
wheels/
*.egg-info/
.eggs/
*.egg
MANIFEST
pip-wheel-metadata/

# ============================================================
# Virtual environments (created by uv venv / uv sync)
# ============================================================
.venv/
venv/
env/
ENV/

# ============================================================
# uv
# ============================================================
# Ignore uv's local cache directory (regenerable)
.uv-cache/
.uv_cache/
.uv/

# NOTE: uv.lock MUST be committed.
# It pins exact dependency versions for reproducible installs.
# Do NOT add uv.lock to this file.

# ============================================================
# Environment variables / secrets
# ============================================================
.env
.env.local
.env.*.local
*.env
secrets.json

# Keep .env.example (or .env.template) if your project provides one
!.env.example
!.env.template

# ============================================================
